<Page x:Class="Gubai_Autoservice.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Gubai_Autoservice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Введите название или описание для поиска" FontSize="20" Margin="5"/>
                <TextBox Name="TBoxSearch" Width="300" FontSize="20" TextChanged="TBoxSearch_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Скидка:" FontSize="20" Margin="5"/>
                <ComboBox Name="ComboType" Width="200" FontSize="20" SelectionChanged="ComboType_SelectionChanged">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 5%</TextBlock>
                    <TextBlock>от 5 до 15%</TextBlock>
                    <TextBlock>от 15 до 30%</TextBlock>
                    <TextBlock>от 30 до 70%</TextBlock>
                    <TextBlock>от 70 до 100%</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5" HorizontalAlignment="Center">
            <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="300" FontSize="20"
                 Name="RButtonUp" IsChecked="True" Checked="RButtonUp_Checked"/>
            <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="300" FontSize="20"
                 Name="RButtonDown" Checked="RButtonDown_Checked"/>
        </StackPanel>
        <ListView Name="ServiceListView" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Image Width="100" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="MainImagePatj">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            img/service_logo.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text ="{Binding Title}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text ="{Binding Cost, StringFormat={}{0:0} рублей за>}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text ="{Binding Duration}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" FontSize="20"></TextBlock>
                        <TextBlock Text ="{Binding Discount, StringFormat=*скидка {0} % }" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="16"></TextBlock>
                                   
                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                            <Button FontSize="20" Name="EditButton"  Content="редактировать" Margin="2"></Button>
                            <Button FontSize="20" Name="DeleteButton" Content="удалить" Margin="2" ></Button>
                        </StackPanel>
                     </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>

<Window x:Class="Gubai_Autoservice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gubai_Autoservice"
        mc:Ignorable="d"
        Title="Gubaidullin_Ilmir" Height="450" Width="800" FontFamily="Tw Cen MT" Icon="/img/service_logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Image Source="/img/service_logo.png" Margin="0,10,0,5" HorizontalAlignment="Left" Width="60" />
        <TextBlock Text="Услуги автосервиса" FontSize="30" HorizontalAlignment="Center"></TextBlock>
        <Frame Grid.Row="1" Name ="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
        <Button Name="BtnBack" Content="Назад" Width="175" Height="30" FontSize="30" HorizontalAlignment="Right" Margin="5" Click="BtnBack_Click" Background="#FFFFAF00"></Button>
    </Grid>
</Window>
